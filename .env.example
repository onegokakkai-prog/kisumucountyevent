# MongoDB connection string. Locally: mongodb://localhost:27017
# On Vercel: your MongoDB Atlas connection string (mongodb+srv://...)
MONGODB_URI=
# Database name (optional, defaults to kisumu_festival)
MONGODB_DB=kisumu_festival
# Password for the organisers' sign-in at /admin/login
ADMIN_PASSWORD=
# Admin sign-in at /admin/login
ADMIN_EMAIL=
# Signs admin session cookies. Any long random string, e.g. `openssl rand -base64 32`
ADMIN_SESSION_SECRET=
# Cloudflare R2 for photos and recordings uploaded from /admin.
# Create an API token with Object Read & Write on the bucket, and enable public access
# (r2.dev subdomain or a custom domain). Add a CORS rule allowing PUT from your site's origin.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket, e.g. https://pub-xxxx.r2.dev or https://media.example.com
R2_PUBLIC_URL=
